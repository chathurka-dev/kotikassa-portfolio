# Kotikassa environment variables
# Copy to .env.local (web) — never commit real values.

# ── Supabase (web + shared) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Receipt scanning (/api/scan) — Phase 9 ─────────────────
# Server-only; set in Vercel project settings + .env.local
OPENAI_API_KEY=sk-your-key
# Model is swappable without a code change; defaults to gpt-4o-mini
OPENAI_RECEIPT_MODEL=gpt-4o-mini

# ── Mobile (apps/mobile/.env) ───────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Absolute base URL of the deployed web app — Expo cannot fetch relative paths.
# Local device dev: use your machine's LAN IP, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_WEB_API_URL=https://your-app.vercel.app
