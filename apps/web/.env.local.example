# Copy this file to .env.local and fill in your Supabase project values
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. Never expose this key in browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Error monitoring. NEXT_PUBLIC_SENTRY_DSN sends browser errors. The remaining
# server-only values upload readable source maps during production builds.
NEXT_PUBLIC_SENTRY_DSN=https://your-public-dsn@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-organization-slug
SENTRY_PROJECT=your-sentry-project-slug
