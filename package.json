{
  "name": "kotikassa",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:db:reset": "supabase db reset && supabase test db",
    "test:e2e": "npm run e2e --workspace=@kotikassa/e2e --",
    "test:e2e:no-reset": "npm run e2e:no-reset --workspace=@kotikassa/e2e --",
    "test:e2e:ui": "npm run e2e:ui --workspace=@kotikassa/e2e --",
    "test:ci": "npm run typecheck --workspace=@kotikassa/shared && npm run typecheck --workspace=@kotikassa/web && npm run typecheck --workspace=@kotikassa/e2e && npm run lint --workspace=@kotikassa/web && npm run test:coverage",
    "build:ci": "node apps/e2e/scripts/run-local-web-build.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff --use-migra",
    "db:new": "supabase migration new",
    "scan:analyze": "tsx apps/web/scripts/analyze-scan-corrections.ts",
    "scan:memory": "tsx apps/web/scripts/manage-correction-memory.ts",
    "scan:automation:evaluate": "tsx apps/web/scripts/record-correction-automation-evaluation.ts",
    "training:export": "node --env-file=apps/web/.env.local apps/web/scripts/export-training-data.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18.0.0"
  }
}
